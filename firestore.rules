rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin UID
    function isAdmin() {
      return request.auth.uid == 'o5pb2aGXmGRJQgMhZwdXLdY9Mrd2';
    }

    // ── Users ──────────────────────────────────────────────
    match /users/{userId} {
      // Any authenticated user can read any user doc.
      // PII filtering is handled client-side (fetchAllUsers strips sensitive fields).
      // Own doc + admin: always readable. Other users: also readable (needed for collection queries).
      allow read: if request.auth != null;

      // Fields a user can write to their own profile
      function userWritableFields() {
        return ['name', 'age', 'dateOfBirth', 'gender', 'profileVisibility', 'city', 'bio',
                'interests', 'identity', 'whatsapp', 'instagram', 'linkedin', 'photoURL',
                'photos', 'createdAt', 'upcomingTrips', 'pastTrips', 'connections',
                'onboardingComplete', 'email', 'travelStyle', 'occupation',
                'screeningAnswer', 'referralSource', 'status', 'appliedAt',
                'blockedUsers', 'savedPlaces'];
      }

      // All fields including admin-only ones
      function allUserFields() {
        return ['name', 'age', 'dateOfBirth', 'gender', 'profileVisibility', 'city', 'bio',
                'interests', 'identity', 'whatsapp', 'instagram', 'linkedin', 'photoURL',
                'photos', 'createdAt', 'upcomingTrips', 'pastTrips', 'connections',
                'onboardingComplete', 'email', 'status', 'appliedAt', 'foundingMember',
                'reviewedAt', 'reviewedBy', 'travelStyle', 'occupation',
                'screeningAnswer', 'referralSource', 'blockedUsers', 'savedPlaces'];
      }

      // Field-value validation
      function validUserData() {
        let d = request.resource.data;
        return d.name is string && d.name.size() >= 1 && d.name.size() <= 100
            && (d.age is int || d.age == null)
            && d.gender is string && d.gender in ['Male', 'Female', '']
            && d.bio is string && d.bio.size() <= 500
            && d.whatsapp is string && d.whatsapp.size() <= 50
            && d.instagram is string && d.instagram.size() <= 50
            && d.interests is list && d.interests.size() <= 20
            && (!('photos' in d) || (d.photos is list && d.photos.size() <= 5))
            && d.onboardingComplete is bool;
      }

      // Partial document for initial signup (before onboarding)
      function validPartialCreate() {
        let d = request.resource.data;
        return d.onboardingComplete == false
            && d.email is string;
      }

      // Users cannot set admin-only fields (foundingMember, reviewedAt, reviewedBy)
      allow create: if request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(userWritableFields())
                    && (validUserData() || validPartialCreate());

      // Own profile: can't modify admin-only fields (foundingMember, reviewedAt, reviewedBy).
      // Other user: only connections field.
      // Admin: can update any fields (for approve/reject/founding member).
      allow update: if request.auth != null
                    && (
                      (request.auth.uid == userId
                        && request.resource.data.keys().hasOnly(allUserFields())
                        && validUserData()
                        && request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['foundingMember', 'reviewedAt', 'reviewedBy']) == false)
                      || (request.auth.uid != userId
                          && request.resource.data.keys().hasOnly(allUserFields())
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connections']))
                      || (isAdmin()
                          && request.resource.data.keys().hasOnly(allUserFields()))
                    );

      // Admin can delete any user. Users can delete own account. Dummy users deletable by any auth user.
      allow delete: if request.auth != null
                    && (isAdmin() || request.auth.uid == userId || userId.matches('dummy-.*'));
    }

    // ── Mail (Trigger Email extension) ────────────────────
    match /mail/{mailId} {
      allow read: if false;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── City Guides ────────────────────────────────────────
    match /cityGuides/{cityId} {
      allow read: if request.auth != null
                  && resource.data.status == 'published';
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // ── Destinations ─────────────────────────────────────
    match /destinations/{destId} {
      allow read: if request.auth != null
                  && resource.data.status == 'published';
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // ── Waitlist ────────────────────────────────────────────
    match /waitlist/{docId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll(['email', 'createdAt']);
      allow update, delete: if false;
    }

    // ── Email Subscribers ─────────────────────────────────
    match /subscribers/{docId} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasAll(['email', 'createdAt'])
                    && request.resource.data.email is string;
      allow update, delete: if false;
    }

    // ── Connection Requests ────────────────────────────────
    match /connectionRequests/{requestId} {
      allow read: if request.auth != null
                  && (resource.data.fromUserId == request.auth.uid
                      || resource.data.toUserId == request.auth.uid
                      || isAdmin());

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['fromUserId', 'fromUserName', 'fromUserAge', 'fromUserGender',
                          'fromUserBio', 'fromUserPhotoURL', 'fromUserInterests',
                          'toUserId', 'toUserName', 'status', 'createdAt'])
                    && request.resource.data.fromUserId == request.auth.uid
                    && request.resource.data.toUserId is string
                    && request.resource.data.toUserId.size() > 0
                    && request.resource.data.fromUserId != request.resource.data.toUserId
                    && request.resource.data.status == 'pending';

      allow update: if request.auth != null
                    && resource.data.toUserId == request.auth.uid
                    && request.resource.data.status in ['accepted', 'rejected']
                    && request.resource.data.fromUserId == resource.data.fromUserId
                    && request.resource.data.toUserId == resource.data.toUserId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.keys().hasOnly(
                         ['fromUserId', 'fromUserName', 'fromUserAge', 'fromUserGender',
                          'fromUserBio', 'fromUserPhotoURL', 'fromUserInterests',
                          'toUserId', 'toUserName', 'status', 'createdAt']);

      // Sender, receiver, or admin can delete
      allow delete: if request.auth != null
                    && (resource.data.fromUserId == request.auth.uid
                        || resource.data.toUserId == request.auth.uid
                        || isAdmin());
    }

    // ── Reports ─────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if request.auth != null && isAdmin();
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.reportedUserId is string
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() >= 1
                    && request.resource.data.reason.size() <= 1000
                    && request.resource.data.keys().hasOnly(
                         ['reporterId', 'reportedUserId', 'reportedUserName',
                          'reason', 'createdAt']);
      allow update, delete: if false;
    }

    // ── Invites ──────────────────────────────────────────
    match /invites/{inviteId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.inviterId == request.auth.uid;
      allow update, delete: if false;
    }

    // ── Conversations ─────────────────────────────────────
    match /conversations/{convId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() >= 1
                      && request.resource.data.text.size() <= 5000;
        allow delete: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      }
    }
  }
}
